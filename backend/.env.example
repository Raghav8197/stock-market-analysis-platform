# App Configuration
JWT_SECRET=super-secret-key-for-stock-analysis-app-2026
DATABASE_URL=sqlite:///./stocks.db

# SMTP Configuration for Password Recovery Emails
# If you are using Gmail, SMTP_HOST should be smtp.gmail.com and SMTP_PASSWORD should be a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TLS=True

# Google OAuth Configuration
# Optional: Set this to validate the audience (Client ID) field of Google Sign-in ID Tokens
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# HTTP Email Relay URL (Alternative to bypass SMTP port blocks on Render)
# Set this to a deployed Google Apps Script web app URL
EMAIL_RELAY_URL=
